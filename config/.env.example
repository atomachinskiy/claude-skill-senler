# Senler API credentials
# Как получить: Senler → канал → «Настройки» → «Работа с API» → создать ключ.
# Проще всего мастером: scripts/senler-launch-wizard.sh (сам найдёт канал и заполнит файл)
# See: config/setup-guide.md

# Required — ключ API (или OAuth-токен) одного канала Senler
SENLER_ACCESS_TOKEN=

# Required — group_id канала в Senler (не ID сообщества ВК!)
# Узнать по ID сообщества ВК: groups/get с vk_group_id=<id> вернёт item.group_id
SENLER_GROUP_ID=

# API version (current: 2)
SENLER_V=2

# Optional — human-readable channel name for log/output clarity
SENLER_CHANNEL_NAME=
