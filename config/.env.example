# Senler API credentials
# How to get: senler.ru → Кабинет → Настройки канала → Подключение → Добавить ключ
# See: config/setup-guide.md

# Required — admin access token for ONE Senler channel
SENLER_ACCESS_TOKEN=

# Required — VK group_id the Senler channel is attached to
# Get from VK community URL (vk.com/club12345678 → 12345678) or Senler channel settings
SENLER_GROUP_ID=

# API version (current: 2)
SENLER_V=2

# Optional — human-readable channel name for log/output clarity
SENLER_CHANNEL_NAME=
